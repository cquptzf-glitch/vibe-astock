{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe AStock",
  "version": "0.1.0",
  "identifier": "com.vibeastock.mobile",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vibe AStock",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    }
  }
}
